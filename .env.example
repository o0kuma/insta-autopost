# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요. (클라우드에서는 서비스의 환경 변수 화면에 넣어요)
# 값이 비어 있어도 '테스트 모드'로 대시보드는 돌아갑니다.

# --- 대시보드 로그인 ---
# 이 PC(127.0.0.1)에서만 쓸 때는 비워 둬도 돼요. 인터넷에 공개되는 서버에서는 반드시 설정하세요.
DASHBOARD_PASSWORD=

# --- Claude (캡션/답글 작성) ---
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# --- Instagram: '인스타 연결하기' 버튼 방식 (클라우드 추천) ---
# Meta 앱 → Instagram → Instagram 로그인을 통한 API 설정 → 비즈니스 로그인 설정의 Instagram 앱 ID / 시크릿
IG_APP_ID=
IG_APP_SECRET=

# --- Instagram: 토큰 직접 입력 방식 (로컬 PC용, 위 버튼 대신) ---
# Meta 앱 대시보드에서 발급한 장기 액세스 토큰 (60일, 앱이 자동 갱신)
IG_ACCESS_TOKEN=
IG_API_VERSION=v27.0
# 1로 두면 토큰이 있어도 실제로 올리지 않고 흉내만 냄
DRY_RUN=

# --- 이 서버의 공개 주소 (Render는 자동으로 채워져서 비워 둬도 돼요) ---
# 예: https://insta-autopost.onrender.com  → 인스타가 사진을 이 서버에서 가져가고, 연결 버튼도 동작
PUBLIC_BASE_URL=

# --- Cloudinary (공개 주소가 없는 로컬 PC에서 실제 게시할 때만 필요, 무료 플랜으로 충분) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 기타 ---
TIMEZONE=Asia/Seoul
HOST=127.0.0.1
PORT=5000
# 사진·DB 저장 위치 (클라우드에서는 영구 디스크 경로)
DATA_DIR=
