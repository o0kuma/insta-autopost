# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# 값이 비어 있어도 '테스트 모드'로 대시보드는 돌아갑니다.

# --- Claude (캡션/답글 작성) ---
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# --- Instagram (Instagram API with Instagram Login) ---
# Meta 앱 대시보드에서 발급한 장기 액세스 토큰 (60일, 앱이 자동 갱신)
IG_ACCESS_TOKEN=
IG_API_VERSION=v27.0
# 1로 두면 토큰이 있어도 실제로 올리지 않고 흉내만 냄
DRY_RUN=

# --- Cloudinary (사진을 공개 URL로 올리는 용도, 무료 플랜으로 충분) ---
# https://cloudinary.com 가입 후 Dashboard 에서 확인
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 대시보드 ---
HOST=127.0.0.1
PORT=5000
